{
  "version": "1.0.0",
  "description": "궤적 과정 검사기의 자체 검증용 — 알려진 정상·불량 궤적과 기대 판정. 검사기 규칙을 바꾸면 이 묶음이 먼저 깨져야 한다.",
  "cases": [
    {
      "id": "good",
      "note": "정상 궤적",
      "spec": {
        "id": "csv-report",
        "requiredTools": [
          "file_ops",
          "python_execute"
        ],
        "allowedTools": [
          "file_ops",
          "python_execute",
          "str_replace_editor",
          "terminate"
        ],
        "forbiddenTools": [
          "browser"
        ],
        "expectedArgs": [
          {
            "tool": "file_ops",
            "args": {
              "op": "read",
              "path": {
                "regex": "\\.csv$"
              }
            }
          }
        ],
        "order": [
          {
            "before": "file_ops",
            "after": "python_execute"
          }
        ],
        "maxCalls": {
          "python_execute": 2
        }
      },
      "steps": [
        {
          "step_number": 1,
          "step_type": "tool_result",
          "tool_name": "file_ops",
          "tool_args": {
            "op": "read",
            "path": "uploads/sales.csv"
          }
        },
        {
          "step_number": 2,
          "step_type": "tool_result",
          "tool_name": "python_execute",
          "tool_args": {
            "code": "print(1)"
          }
        },
        {
          "step_number": 3,
          "step_type": "judge",
          "tool_name": null,
          "tool_args": null
        },
        {
          "step_number": 9,
          "step_type": "tool_result",
          "tool_name": "terminate",
          "tool_args": {
            "summary": "완료"
          }
        }
      ],
      "expect": {
        "passed": true
      }
    },
